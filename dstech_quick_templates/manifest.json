{
  "manifest_version": 3,
  "name": "DSTech - Respostas rápidas",
  "version": "1.2.0",
  "description": "Insere, cria, edita e exclui modelos de atendimento e mensagens Omini em páginas da Web.",
  "minimum_chrome_version": "146.0.7680.177",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css",
        "templates.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "permissions": [
    "storage"
  ]
}
